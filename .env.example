# ==============================================================================
# STATCUT FOOTBALL ANALYTICS SYSTEM - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

APP_NAME="Statcut Analytics"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000
DEBUG=True
SECRET_KEY="statcut-football-analytics-secret-key"

INPUT_VIDEO_DIR="data/input_videos"
OUTPUT_VIDEO_DIR="data/output_videos"
REPORTS_DIR="reports"
STUBS_DIR="stubs"

MODEL_WEIGHTS="models/weights/best.pt"
FALLBACK_MODEL_WEIGHTS="yolov8x.pt"
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
DETECTOR_DEVICE="auto"
ROBOFLOW_API_KEY="your_roboflow_api_key_here"

TARGET_FPS=25
PROCESS_WIDTH=1280
PROCESS_HEIGHT=720

PITCH_LENGTH_METERS=105.0
PITCH_WIDTH_METERS=68.0
POSSESSION_PROXIMITY_METERS=2.0
MAX_SPEED_CAP_KM_H=38.0
